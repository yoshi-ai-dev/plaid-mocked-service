{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "plaid-mocked-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-13",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PLAID_MOCKED_SERVICE_STATE",
        "class_name": "PlaidMockedServiceState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["PlaidMockedServiceState"]
    }
  ]
}
